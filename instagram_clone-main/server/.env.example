# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# Never commit `.env` — it is gitignored for a reason.
# ---------------------------------------------------------------------------

# --- Core ---
PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/instaclone
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# Origin allowed by the socket.io CORS policy (the Next.js app URL)
CLIENT_URL=http://localhost:3000

# --- Media storage (Cloudinary) — stories AND posts upload through the
# server's /api/upload endpoint, so these three are required for media features.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Gmail) ---
# Needed for OTP emails (language change / Chrome login), invoices and
# post-published notifications. EMAIL_PASS must be a 16-character Google
# App Password (requires 2-Step Verification), NOT your Gmail password.
# Without these, emails print to the server console as [EMAIL STUB].
EMAIL_USER=
EMAIL_PASS=

# --- SMS (Twilio) — optional ---
# Without these, mobile OTPs print to the console as [SMS STUB] and the
# verification flow still works. Trial SMS to Indian numbers is commonly
# blocked by DLT/TRAI carrier rules, so console mode is the reliable demo path.
# Requires `npm i twilio` once you set the credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Payments (Razorpay) ---
# Test-mode keys (rzp_test_...) are free and need no KYC. Without these the
# checkout runs in clearly-flagged stub mode: same code path, no real gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the secret you type when creating the webhook in the Razorpay
# dashboard (Settings -> Webhooks -> https://<public-host>/api/subscription/webhook).
# Without it the webhook endpoint returns 503.
RAZORPAY_WEBHOOK_SECRET=

# --- Payment window override (dev/demo only) ---
# The assignment rule is 05:00-11:00 IST and that is the default, so leave
# these unset for production. Set them to run a payment demo at another hour;
# the UI copy still quotes the documented 5-11 AM IST window.
# PAYMENT_WINDOW_START_HOUR=5
# PAYMENT_WINDOW_END_HOUR=11

# --- AI caption enhancement (Groq) — optional ---
GROQ_API=
